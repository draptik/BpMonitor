#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

# Rejects a commit whose gitmoji doesn't match its type — keep in sync with .claude/skills/git-workflow/SKILL.md
# Single source of truth for allowed pairs: both the check below and its help text read from this list.
allowed_pairs="✨ feat
🐛 fix
🔒 fix
♻️ refactor
✅ test
📝 docs
🔧 chore
🗑️ chore
⬆️ chore
🎉 chore
💄 style
👷 ci
⚡️ perf
🚀 chore"

msg_file="$1"
first_line=$(head -n1 "$msg_file")

emoji="${first_line%% *}"
rest="${first_line#* }"
type=$(printf '%s' "$rest" | grep -oE '^[a-z]+')

pair="$emoji $type"

if printf '%s\n' "$allowed_pairs" | grep -qxF "$pair"; then
  exit 0
fi

echo "ERROR: commit message emoji/type mismatch: '$pair'"
echo "Allowed pairs (see .claude/skills/git-workflow/SKILL.md):"
printf '%s\n' "$allowed_pairs" | sed 's/^/  /'
exit 1
