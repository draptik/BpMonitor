#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

# Rejects a commit whose gitmoji doesn't match its type — keep in sync with .claude/skills/git-workflow/SKILL.md
# Single source of truth for allowed pairs, compared byte-for-byte (so ♻️ ⚡️ 🗑️ need their U+FE0F).
allowed_pairs="✨ feat
🚸 feat
🌐 feat
♿️ feat
💥 feat
🐛 fix
🔒 fix
🩹 fix
🚑️ fix
♿️ fix
🌐 fix
♻️ refactor
🎨 refactor
🚚 refactor
🔥 refactor
✅ test
🧪 test
🤡 test
♻️ test
📝 docs
💡 docs
📄 docs
💄 style
🎨 style
🚨 style
👷 ci
💚 ci
⚡️ perf
📦️ build
🔧 chore
🔨 chore
⬆️ chore
⬇️ chore
📌 chore
➕ chore
➖ chore
🗑️ chore
🔥 chore
🙈 chore
🚚 chore
🔖 chore
🚀 chore
🎉 chore"

msg_file="$1"
first_line=$(head -n1 "$msg_file")

emoji="${first_line%% *}"
rest="${first_line#* }"
type=$(printf '%s' "$rest" | grep -oE '^[a-z]+')

pair="$emoji $type"

if printf '%s\n' "$allowed_pairs" | grep -qxF "$pair"; then
  exit 0
fi

echo "ERROR: commit message emoji/type mismatch: '$pair'"
variation_selector=$(printf '\357\270\217')
if printf '%s\n' "$allowed_pairs" | grep -qxF "$emoji$variation_selector $type"; then
  echo "The emoji is missing its variation selector (U+FE0F) — use '$emoji$variation_selector'."
fi
echo "Allowed pairs (see .claude/skills/git-workflow/SKILL.md):"
printf '%s\n' "$allowed_pairs" | sed 's/^/  /'
exit 1
