<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="WebAppFixture.fs" />
    <Compile Include="AssemblyInfo.fs" />
    <Compile Include="SmokeTests.fs" />
    <Compile Include="MedicationsSyncFirefoxTests.fs" />
    <Compile Include="RecentScrubberFirefoxTests.fs" />
    <Compile Include="MedicationsScrubberTests.fs" />
    <Compile Include="RecentReadingsListTests.fs" />
    <Compile Include="SettingsSectionMemoryTests.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="Unquote" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.Playwright" />
  </ItemGroup>

  <ItemGroup>
    <!-- Referenced only so `dotnet test` builds the web app before the suite runs;
         the app itself is launched out-of-process via `dotnet exec`, not in-process. -->
    <ProjectReference Include="..\BpMonitor.Web\BpMonitor.Web.fsproj" ReferenceOutputAssembly="false" />
    <!-- ProcessReadiness (BpMonitor.Web.E2E namespace) lives in BpMonitor.TestSupport, so its own
         unit tests run in BpMonitor.Web.Tests (CI's fast lane) instead of the browser-driven
         "Test (E2E)" step, without pulling a test project's coverage-instrumented assembly
         into this suite's dependency graph. -->
    <ProjectReference Include="..\BpMonitor.TestSupport\BpMonitor.TestSupport.fsproj" />
  </ItemGroup>

</Project>
