# Multi-stage build for BpMonitor.Web.
# Build context must be the `code/` directory so the referenced projects
# (Core, Data, Charts) are available:
#   podman build -t bpmonitor-web -f BpMonitor.Web/Containerfile .
FROM mcr.microsoft.com/dotnet/sdk:11.0 AS build
WORKDIR /src
COPY . .
# Must be valid SemVer: -p:Version also sets the NuGet package version that restore validates.
ARG VERSION=0.0.0-dev
RUN dotnet publish BpMonitor.Web/BpMonitor.Web.fsproj -c Release -p:Version=$VERSION -o /app \
 && mkdir /data-mount

# Chiseled: no shell or package manager, so far fewer base-image CVEs.
# -extra adds the ICU culture data the German UI formatting needs.
FROM mcr.microsoft.com/dotnet/aspnet:11.0-resolute-chiseled-extra AS runtime
WORKDIR /app
COPY --from=build /app .

# No shell for `mkdir`, so the volume mount point is copied in pre-owned by the non-root `app` user.
# Root-owned data from older images needs a one-time chown (docs/example-deploy/README.md).
COPY --from=build --chown=$APP_UID:$APP_UID /data-mount /data
USER $APP_UID

# Links the published GHCR package to its source repository.
LABEL org.opencontainers.image.source="https://github.com/draptik/BpMonitor"

# Bind on all interfaces (reachable on the homelab LAN, incl. phones) and keep
# the SQLite database on a mounted volume so it survives redeploys.
ENV ASPNETCORE_URLS=http://0.0.0.0:5000
ENV ConnectionStrings__DefaultConnection="Data Source=/data/bpmonitor.db"
# Data Protection keys encrypt the auth cookie (incl. "remember me" logins) — keep
# them on the same volume as the database so they survive container recreation.
ENV BpMonitor__DataProtectionKeyPath=/data/keys
VOLUME /data
EXPOSE 5000

# --start-period covers SchemaMigrations running synchronously before the app
# starts serving requests.
# The app probes its own /health (exit 0/1) since there's no curl.
HEALTHCHECK --interval=30s --timeout=3s --start-period=15s --retries=3 \
  CMD ["dotnet", "BpMonitor.Web.dll", "--healthcheck"]

ENTRYPOINT ["dotnet", "BpMonitor.Web.dll"]
