<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup Label="FSharp">
    <PackageVersion Include="FSharp.Core" Version="11.0.101-rc3.26522.148" />
    <PackageVersion Include="FsToolkit.ErrorHandling" Version="5.2.0" />
    <PackageVersion Include="FSharp.SystemTextJson" Version="1.4.36" />
  </ItemGroup>
  <ItemGroup Label="Web">
    <PackageVersion Include="Falco" Version="5.2.0" />
    <PackageVersion Include="Falco.Markup" Version="1.4.0" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup Label="Data">
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="11.0.0-rc.3.26522.148" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="11.0.0-rc.3.26522.148" />
  </ItemGroup>
  <ItemGroup Label="Charts">
    <PackageVersion Include="Plotly.NET" Version="6.0.0" />
  </ItemGroup>
  <ItemGroup Label="Benchmarks">
    <PackageVersion Include="BenchmarkDotNet" Version="0.16.0-preview.2" />
  </ItemGroup>
  <ItemGroup Label="Test - Platform">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
  </ItemGroup>
  <ItemGroup Label="Test - Helpers">
    <PackageVersion Include="Unquote" Version="7.0.1" />
    <PackageVersion Include="Verify.XunitV3" Version="33.3.4" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
  </ItemGroup>
  <ItemGroup Label="Test - PBT">
    <PackageVersion Include="FsCheck" Version="3.6.0" />
    <PackageVersion Include="FsCheck.Xunit.v3" Version="3.6.0" />
  </ItemGroup>
  <ItemGroup Label="Test - Arch">
    <PackageVersion Include="TngTech.ArchUnitNET.xUnit" Version="0.13.5" />
  </ItemGroup>
  <ItemGroup Label="Test - E2E">
    <PackageVersion Include="Microsoft.Playwright" Version="1.64.1" />
  </ItemGroup>
</Project>
