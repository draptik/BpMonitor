# Podman Quadlet unit for BpMonitor.Web.
#
# Install (rootful):  copy to /etc/containers/systemd/
# Install (rootless): copy to ~/.config/containers/systemd/
# Then:               systemctl [--user] daemon-reload && systemctl [--user] start bpmonitor-web
#
# Uses the prebuilt image from GitHub Container Registry. Pin a release by
# replacing :latest with a version tag (e.g. :1.14.0), or point Image= at a
# locally built image (see README.md).
[Unit]
Description=BpMonitor Web UI
After=network-online.target
Wants=network-online.target

[Container]
Image=ghcr.io/draptik/bpmonitor-web:latest
PublishPort=5000:5000
# :U hands /data to the container's non-root user (UID 1654), incl. data written by older root images
Volume=bpmonitor-data.volume:/data:U
Environment=ConnectionStrings__DefaultConnection=Data Source=/data/bpmonitor.db
Environment=TZ=Europe/Berlin
# Environment=BpMonitor__RememberMeDays=30
# JSON form: the image has no shell (or curl), so the app probes its own /health
HealthCmd=["dotnet", "BpMonitor.Web.dll", "--healthcheck"]
HealthInterval=30s
HealthTimeout=3s
HealthStartPeriod=15s
HealthRetries=3

[Service]
Restart=always

[Install]
WantedBy=multi-user.target default.target
